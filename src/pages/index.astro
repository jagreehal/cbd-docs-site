---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import { docMeta } from '../doc-meta.ts';
import { day } from '../format.ts';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = (await getCollection('docs')).sort((a, b) => a.id.localeCompare(b.id));
const repoNames = [...new Set(docs.map((doc) => doc.id.split('/')[0]))];
const repos = [
  ...repoNames.filter((repo) => repo === 'cbd-handbook'),
  ...repoNames.filter((repo) => repo !== 'cbd-handbook').sort(),
];
---

<StarlightPage
  frontmatter={{
    title: 'Acme docs',
    owner: 'platform',
    description: 'Operational and technical documentation from each enrolled repository.',
    tableOfContents: false,
  }}
>
  <p>
    {docs.length} documents from {repos.length} repositories. Each team commits Markdown to
    <code>docs/</code> in its own repository. This site rebuilds from the repositories tagged
    <code>cbd-publisher</code>.
  </p>

  <h2>Start here: the 02:40 path</h2>
  <p>Company incident policy, then the engineering runbook it points at.</p>
  <ol>
    <li><a href={`${base}cbd-handbook/incident-communications/`}>Incident communications</a></li>
    <li><a href={`${base}cbd-payments-service/runbook/`}>Payments service runbook</a></li>
  </ol>

  <h2>For agents</h2>
  <ul>
    <li>
      Append <code>.md</code> to a page URL for the raw Markdown. Its frontmatter carries the
      owner, the last git change and the source file on GitHub.
    </li>
    <li><a href={`${base}llms.txt`}><code>llms.txt</code></a> lists every document with its owner and date.</li>
    <li>
      <a href={`${base}contracts/docs-manifest.json`}><code>contracts/docs-manifest.json</code></a> holds
      the same index as JSON, with the links between documents.
    </li>
  </ul>

  {
    repos.map((repo) => (
      <>
        <h2>{repo}</h2>
        <ul>
          {docs
            .filter((doc) => doc.id.startsWith(`${repo}/`))
            .map((doc) => {
              const meta = docMeta(doc.id);
              const updated = day(meta?.updated);
              return (
                <li>
                  <a href={`${base}${doc.id}/`}>{doc.data.title}</a>
                  {' · '}
                  {doc.data.owner}
                  {updated && <> · updated {updated}</>}
                </li>
              );
            })}
        </ul>
      </>
    ))
  }
</StarlightPage>
