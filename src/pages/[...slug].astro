---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { manifest } from '../manifest.ts';
import { docPaths } from '../paths.ts';
import { day } from '../format.ts';

export const getStaticPaths = docPaths;

const { doc } = Astro.props;
const { Content } = await render(doc);

const entry = manifest[doc.id];
const [repo] = doc.id.split('/');
const titleOf = (id: string) => manifest[id]?.title ?? id;
const updated = day(entry?.updated);
---

<Layout title={`${doc.data.title} · Acme docs`}>
  <nav class="crumbs"><a href={base}>All docs</a> / {repo}</nav>

  <div class="meta byline">
    Owned by <strong>{doc.data.owner}</strong>
    {updated && <>{' · '}last changed {updated}</>}
    {' · '}<a href={`${base}${doc.id}.md`}>view as markdown</a>
  </div>

  <article>
    <Content />
  </article>

  {
    (doc.data.related?.length || entry?.linkedFrom.length) && (
      <aside>
        {doc.data.related?.length ? (
          <div>
            <h3>Related</h3>
            <ul>
              {doc.data.related.map((id: string) => (
                <li>
                  <a href={`${base}${id}`}>{titleOf(id)}</a> <span class="meta">{id.split('/')[0]}</span>
                </li>
              ))}
            </ul>
          </div>
        ) : null}
        {entry?.linkedFrom.length ? (
          <div>
            <h3>Linked from</h3>
            <ul>
              {entry.linkedFrom.map((id) => (
                <li>
                  <a href={`${base}${id}`}>{titleOf(id)}</a> <span class="meta">{id.split('/')[0]}</span>
                </li>
              ))}
            </ul>
          </div>
        ) : null}
      </aside>
    )
  }
</Layout>

<style>
  .crumbs {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  .byline {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1.5rem;
  }
  article :global(h1) {
    font-size: 1.75rem;
    letter-spacing: -0.02em;
    margin-top: 0;
  }
  article :global(h2) {
    margin-top: 2.25rem;
  }
  aside {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  aside h3 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }
  aside ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  aside li {
    padding: 0.2rem 0;
  }
</style>
