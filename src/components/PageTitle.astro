---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { docMeta } from '../doc-meta.ts';
import { day } from '../format.ts';

const meta = docMeta(Astro.locals.starlightRoute.id);
const updated = day(meta?.updated);
---

<Default />

{
  meta && (
    <div class="byline">
      <span>
        Owned by <strong>{meta.owner}</strong> in <code>{meta.repo}</code>
        {updated && <> · last changed {updated}</>}
      </span>
      <span class="links">
        <a href={meta.source}>Source on GitHub</a>
        <a href={meta.markdown}>View as Markdown</a>
        <button type="button" data-copy-markdown={meta.markdown}>Copy as Markdown</button>
      </span>
    </div>
  )
}

<script>
  // Copies the .md twin, so a reader can paste the page into an assistant with
  // its owner and date intact.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-markdown]')) {
    button.addEventListener('click', async () => {
      const text = await (await fetch(button.dataset.copyMarkdown!)).text();
      await navigator.clipboard.writeText(text);
      button.textContent = 'Copied';
      setTimeout(() => (button.textContent = 'Copy as Markdown'), 1500);
    });
  }
</script>

<style>
  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    justify-content: space-between;
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .links a,
  .links button {
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--sl-color-gray-5);
  }
  .links button {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .links a:hover,
  .links button:hover {
    color: var(--sl-color-white);
    text-decoration-color: currentColor;
  }
</style>
