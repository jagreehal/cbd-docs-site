{
  "name": "cbd-docs-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "repos": "rm -rf repos && mkdir repos && for r in $(gh repo list jagreehal --topic cbd-publisher --json name --jq '.[].name'); do git clone -q --filter=blob:none https://github.com/jagreehal/$r repos/$r; done && ls repos",
    "manifest": "node build-manifest.ts",
    "dev": "astro dev",
    "build": "astro build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/starlight": "0.42.2",
    "@twinkleplop/bash": "0.1.4",
    "@twinkleplop/json": "0.1.4",
    "@twinkleplop/rehype": "0.1.4",
    "@twinkleplop/theme-github": "0.2.1",
    "astro": "7.3.3",
    "starlight-theme-nova": "0.12.3",
    "yaml": "^2.6.0",
    "zod": "4.4.3"
  },
  "packageManager": "pnpm@9.15.0"
}
